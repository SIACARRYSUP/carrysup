    <div class="grid">
      <div class="card">
        <h3 class="lv">Bez apstādināšanas</h3>
        <p class="en">Operations continue uninterrupted</p>
      </div>
      <div class="card">
        <h3 class="lv">Elastīgs grafiks</h3>
        <p class="en">Night, weekend, and urgent projects</p>
      </div>
      <div class="card">
        <h3 class="lv">Pilnīga konfidencialitāte</h3>
