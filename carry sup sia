  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #000000;
      --text: #ffffff;
      --muted: #cccccc;
      --accent: #1e90ff;
      --card: #111122;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.55;
    }

    /* Tīrs attēla baneris – bez teksta virsū */
    .banner {
      position: relative;
      width: 100%;
      height: 70vh;
      min-height: 500px;
      overflow: hidden;
    }

    .banner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: brightness(0.75) contrast(1.1);
    }

    .banner-gradient {
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.85) 85%, var(--bg) 100%);
      pointer-events: none;
    }

    /* Saturs zem attēla */
    .content {
      position: relative;
      background: var(--bg);
      padding: 5rem 2rem 8rem;
      text-align: center;
    }

    .content-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    h1 {
      font-size: clamp(3.5rem, 9vw, 7.5rem);
      font-weight: 900;
      letter-spacing: -0.05em;
      margin-bottom: 1.2rem;
      line-height: 0.92;
    }

    .subtitle {
      font-size: clamp(1.5rem, 4vw, 2.2rem);
      font-weight: 400;
      opacity: 0.95;
      margin-bottom: 3rem;
    }

    .en {
      font-size: 0.6em;
      font-weight: 300;
      opacity: 0.78;
      display: block;
      margin-top: 0.4rem;
    }

    .bullets {
      font-size: 1.35rem;
      max-width: 700px;
      margin: 0 auto 4rem;
      text-align: left;
    }

    .bullets span {
      display: block;
      margin: 1.3rem 0;
    }

    .bullets .en {
      font-size: 0.76em;
      opacity: 0.72;
      margin-top: 0.3rem;
    }

    .cta {
      display: inline-block;
      background: var(--accent);
      color: #000;
      font-size: 1.6rem;
      font-weight: 700;
      padding: 1.5rem 3.8rem;
      border-radius: 999px;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 0 50px rgba(30, 144, 255, 0.4);
    }

    .cta:hover {
      transform: translateY(-5px);
      box-shadow: 0 0 70px rgba(30, 144, 255, 0.6);
    }

    .phone {
      font-size: clamp(2.2rem, 5vw, 3rem);
      font-weight: 800;
      margin: 3.5rem 0 2rem;
    }

    .note {
      font-size: 1.1rem;
      opacity: 0.7;
    }

    /* Advantages */
    .advantages {
      padding: 6rem 2rem;
      text-align: center;
      background: var(--bg);
    }

    .advantages h2 {
      font-size: 3.2rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 3rem;
      max-width: 1200px;
      margin: 5rem auto 0;
    }

    .card {
      background: var(--card);
      padding: 2.5rem;
      border-radius: 20px;
      border: 1px solid rgba(255,255,255,0.07);
    }

    .card h3 {
      font-size: 1.7rem;
      margin-bottom: 1rem;
    }

    footer {
      padding: 4rem 2rem;
      text-align: center;
      font-size: 1rem;
      opacity: 0.5;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    @media (max-width: 768px) {
      .banner { height: 50vh; min-height: 400px; }
      h1 { font-size: clamp(3rem, 12vw, 5.5rem); }
      .subtitle { font-size: 1.8rem; }
      .bullets { font-size: 1.2rem; }
    }
  </style>
</head>
<body>

  <!-- Tīrs attēla baneris bez teksta -->
